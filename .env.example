VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# SRS backend (srs/). Pusher assignments are read from and written to its roll-day plan.
VITE_SRS_URL=https://srs.westus2.cloudapp.azure.com
# The SRS shared password (SRS_KEY on the server). It ends up in the built JavaScript, so set it
# only in the deploy environment or your local .env; never commit it.
VITE_SRS_KEY=
